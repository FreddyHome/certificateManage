<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath />
  </parent>
  <groupId>com.certmanage</groupId>
  <artifactId>certificate-manage</artifactId>
  <version>0.1.0</version>
  <name>Certificate Manage</name>
  <properties>
    <java.version>21</java.version>
    <npm.suffix />
    <skipTests>false</skipTests>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.apache.sshd</groupId>
      <artifactId>sshd-sftp</artifactId>
      <version>2.16.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <version>1.86</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.4</version>
        <configuration>
          <java>
            <includes>
              <include>src/test/java/com/certmanage/FixedComponentsWorkflowTest.java</include>
              <include>src/main/java/com/certmanage/sync/FixedHttpComponents.java</include>
              <include>src/main/java/com/certmanage/sync/BusinessComponents.java</include>
              <include>src/main/java/com/certmanage/common/Raw*.java</include>
              <include>src/main/java/com/certmanage/common/ExecutionLog.java</include>
              <include>src/main/java/com/certmanage/common/ExecutionLogController.java</include>
              <include>src/test/java/com/certmanage/RawExecutionLog*.java</include>
              <include>src/test/java/com/certmanage/RawAuditPoolTest.java</include>
              <include>src/main/java/com/certmanage/sync/WorkflowValidator.java</include>
              <include>src/main/java/com/certmanage/sync/WorkflowRunner.java</include>
              <include>src/main/java/com/certmanage/server/RemoteTransport.java</include>
              <include>src/main/java/com/certmanage/server/ServerService.java</include>
              <include>src/main/java/com/certmanage/server/SshCommandTransport.java</include>
              <include>src/test/java/com/certmanage/server/SshSchemaMigrationTest.java</include>
              <include>src/main/java/db/migration/V10__ssh_shell_steps.java</include>
              <include>src/test/java/com/certmanage/server/FixedHttpTransportTest.java</include>
              <include>src/test/java/com/certmanage/server/SftpTimestampTest.java</include>
              <include>src/main/java/com/certmanage/customer/*.java</include>
              <include>src/main/java/com/certmanage/certificate/CertificateService.java</include>
              <include>src/main/java/com/certmanage/certificate/CertificateController.java</include>
              <include>src/main/java/com/certmanage/sync/WorkflowService.java</include>
              <include>src/main/java/com/certmanage/sync/StoreMaker.java</include>
              <include>src/main/java/com/certmanage/notification/NotificationService.java</include>
              <include>src/main/java/com/certmanage/sync/WorkflowQueries.java</include>
              <include>src/main/java/com/certmanage/sync/WorkflowScheduler.java</include>
              <include>src/main/java/com/certmanage/sync/Schedule*.java</include>
              <include>src/test/java/com/certmanage/customer/*.java</include>
              <include>src/test/java/com/certmanage/sync/*.java</include>
              <include>src/test/java/com/certmanage/CustomerIdentificationTest.java</include>
              <include>src/test/java/com/certmanage/CertificateEnabledTest.java</include>
              <include>src/test/java/com/certmanage/CertificateArchiveTest.java</include>
              <include>src/test/java/com/certmanage/CertificateImportDeduplicationTest.java</include>
              <include>src/test/java/com/certmanage/CertificateDeleteTest.java</include>
              <include>src/test/java/com/certmanage/WorkflowTest.java</include>
              <include>src/test/java/com/certmanage/notification/*.java</include>
            </includes>
            <googleJavaFormat>
              <version>1.30.0</version>
            </googleJavaFormat>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>format-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>production</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>npm-ci</id>
                <phase>generate-resources</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <workingDirectory>frontend</workingDirectory>
                  <executable>npm${npm.suffix}</executable>
                  <arguments>
                    <argument>ci</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>frontend-build</id>
                <phase>generate-resources</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <workingDirectory>frontend</workingDirectory>
                  <executable>npm${npm.suffix}</executable>
                  <arguments>
                    <argument>run</argument>
                    <argument>build</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>frontend-test</id>
                <phase>test</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <skip>${skipTests}</skip>
                  <workingDirectory>frontend</workingDirectory>
                  <executable>npm${npm.suffix}</executable>
                  <arguments>
                    <argument>run</argument>
                    <argument>verify</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <executions>
              <execution>
                <id>frontend-copy</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                  <resources>
                    <resource>
                      <directory>frontend/dist</directory>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>windows</id>
      <activation>
        <os>
          <family>Windows</family>
        </os>
      </activation>
      <properties>
        <npm.suffix>.cmd</npm.suffix>
      </properties>
    </profile>
  </profiles>
</project>
