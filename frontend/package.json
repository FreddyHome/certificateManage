{
  "name": "certificate-manage-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write src vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src vite.config.ts tsconfig.json package.json",
    "verify": "npm run format:check && npm test && npm run typecheck"
  },
  "dependencies": {
    "element-plus": "^2.11.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "3.10.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.0.0"
  }
}
